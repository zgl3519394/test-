<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_ABProtocol" Id="{ec6ffe1d-deee-4e3b-883b-9852cd591156}">
    <Declaration><![CDATA[TYPE ST_ABProtocol :
STRUCT
    // Confirm only against the NEW firmware, including presence before enable.
    bConfirmed : BOOL := FALSE;
    nPositionIndex : UINT := 3; // PDO element 3 = Axis0. Elements 9/10 are not assumed positions.
    dwPresentMask : DWORD := 0; // REQUIRED: existing status bits, never a position/ID heuristic.
    dwPresentValue : DWORD := 0;
    dwFaultMask : DWORD := 16#8;
    dwActiveControl : DWORD := 16#1;
    dwInactiveControl : DWORD := 0;
    // Reserved words: no business ID is copied. Only confirmed non-ID metadata is allowed.
    dwMetadataMask1 : DWORD := 0;
    dwMetadataMask2 : DWORD := 0;
    dwMetadata1 : DWORD := 0;
    dwMetadata2 : DWORD := 0;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
